# Server Port (optional for Vercel, used for local dev)
PORT=5001

# MongoDB Connection String (Required on Vercel)
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/task-manager?retryWrites=true&w=majority"

# JWT Secret for authentication tokens (Required on Vercel)
JWT_SECRET="your_jwt_secret_key_here"

# Frontend Base URL for email invitation and password reset links
BASE_URL="https://your-frontend-domain.vercel.app"

# Email Configuration (Nodemailer)
EMAIL_USER="your-email@gmail.com"
EMAIL_APP_PASSWORD="your-google-app-password"

# Timezone (optional)
TZ=Asia/Kolkata
